{
  "name": "Streak",
  "type": "object",
  "properties": {
    "kid_email": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "current_count": {
      "type": "number",
      "default": 0
    },
    "longest_count": {
      "type": "number",
      "default": 0
    },
    "last_completed_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "kid_email",
    "family_id"
  ],
  "rls": {
    "create": {
      "data.kid_email": "{{user.email}}",
      "data.family_id": "{{user.data.family_id}}",
      "user_condition": {
        "app_role": "kid"
      }
    },
    "read": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}",
          "user_condition": {
            "app_role": "parent"
          }
        },
        {
          "data.kid_email": "{{user.email}}",
          "user_condition": {
            "app_role": "kid"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.kid_email": "{{user.email}}",
          "data.family_id": "{{user.data.family_id}}",
          "user_condition": {
            "app_role": "kid"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}",
          "user_condition": {
            "app_role": "parent"
          }
        }
      ]
    },
    "delete": {
      "data.family_id": "{{user.data.family_id}}",
      "user_condition": {
        "app_role": "parent"
      }
    }
  }
}