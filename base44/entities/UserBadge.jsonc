{
  "name": "UserBadge",
  "type": "object",
  "properties": {
    "kid_email": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "badge_key": {
      "type": "string"
    },
    "badge_title": {
      "type": "string"
    },
    "badge_emoji": {
      "type": "string"
    },
    "badge_tier": {
      "type": "string"
    }
  },
  "required": [
    "kid_email",
    "badge_key"
  ],
  "rls": {
    "read": {
      "data.family_id": "{{user.family_id}}"
    },
    "create": {
      "data.family_id": "{{user.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.family_id}}"
    },
    "delete": {
      "data.family_id": "{{user.family_id}}",
      "user_condition": {
        "app_role": "parent"
      }
    }
  }
}