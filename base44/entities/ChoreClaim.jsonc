{
  "name": "ChoreClaim",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string"
    },
    "chore_id": {
      "type": "string"
    },
    "chore_title": {
      "type": "string"
    },
    "chore_emoji": {
      "type": "string"
    },
    "chore_value": {
      "type": "number"
    },
    "kid_email": {
      "type": "string"
    },
    "kid_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "claimed",
        "before_done",
        "submitted",
        "approved",
        "redo"
      ],
      "default": "claimed"
    },
    "before_photo_url": {
      "type": "string"
    },
    "after_photo_url": {
      "type": "string"
    },
    "review_comment": {
      "type": "string"
    },
    "paid_amount": {
      "type": "number"
    },
    "claim_date": {
      "type": "string",
      "format": "date"
    },
    "ai_verdict": {
      "type": "string",
      "enum": [
        "pending",
        "looks_good",
        "needs_review",
        "suspicious"
      ],
      "description": "AI verdict on the before/after photo pair"
    },
    "ai_score": {
      "type": "number",
      "description": "Quality/effort score 0-100"
    },
    "ai_reasoning": {
      "type": "string"
    },
    "requires_photo": {
      "type": "boolean",
      "default": true,
      "description": "Snapshot of the chore's photo requirement at claim time"
    }
  },
  "required": [
    "family_id",
    "chore_id",
    "kid_email"
  ]
}