{
  "name": "User",
  "type": "object",
  "properties": {
    "app_role": {
      "type": "string",
      "enum": [
        "parent",
        "kid"
      ],
      "description": "Role within the family"
    },
    "family_id": {
      "type": "string"
    },
    "avatar_emoji": {
      "type": "string",
      "default": "\ud83e\udd8a"
    },
    "age": {
      "type": "number"
    },
    "display_name": {
      "type": "string"
    }
  }
}