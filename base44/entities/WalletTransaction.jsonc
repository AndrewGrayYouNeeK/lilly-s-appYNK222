{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "kid_email": {
      "type": "string"
    },
    "family_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "earn",
        "bonus",
        "spend",
        "cashout"
      ],
      "default": "earn"
    },
    "description": {
      "type": "string"
    },
    "claim_id": {
      "type": "string"
    }
  },
  "required": [
    "kid_email",
    "family_id",
    "amount"
  ],
  "rls": {
    "read": {
      "data.family_id": "{{user.family_id}}"
    },
    "create": {
      "data.family_id": "{{user.family_id}}"
    },
    "update": {
      "data.family_id": "{{user.family_id}}",
      "user_condition": {
        "app_role": "parent"
      }
    },
    "delete": {
      "data.family_id": "{{user.family_id}}",
      "user_condition": {
        "app_role": "parent"
      }
    }
  }
}