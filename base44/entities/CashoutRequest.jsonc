{
  "name": "CashoutRequest",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string"
    },
    "kid_email": {
      "type": "string"
    },
    "kid_name": {
      "type": "string"
    },
    "kid_emoji": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Requested cashout amount"
    },
    "note": {
      "type": "string",
      "description": "Optional note from kid"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "denied"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string",
      "description": "How the parent paid (cash, venmo, zelle, etc.)"
    },
    "parent_note": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    }
  },
  "required": [
    "family_id",
    "kid_email",
    "amount"
  ],
  "rls": {
    "read": {
      "data.family_id": "{{user.family_id}}"
    },
    "create": {
      "data.family_id": "{{user.family_id}}",
      "data.kid_email": "{{user.email}}",
      "user_condition": {
        "app_role": "kid"
      }
    },
    "update": {
      "data.family_id": "{{user.family_id}}",
      "user_condition": {
        "app_role": "parent"
      }
    },
    "delete": {
      "data.family_id": "{{user.family_id}}",
      "user_condition": {
        "app_role": "parent"
      }
    }
  }
}