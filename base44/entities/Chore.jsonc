{
  "name": "Chore",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "value": {
      "type": "number",
      "description": "Payout amount in family currency"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "default": "easy"
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "one_time",
        "daily",
        "weekly"
      ],
      "default": "daily"
    },
    "emoji": {
      "type": "string",
      "default": "\u2728"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "requires_photo": {
      "type": "boolean",
      "default": true,
      "description": "If true, kid must upload before/after photos and AI assesses quality"
    }
  },
  "required": [
    "family_id",
    "title",
    "value"
  ],
  "rls": {
    "read": {
      "data.family_id": "{{user.family_id}}"
    },
    "create": {
      "data.family_id": "{{user.family_id}}",
      "user_condition": {
        "app_role": "parent"
      }
    },
    "update": {
      "data.family_id": "{{user.family_id}}",
      "user_condition": {
        "app_role": "parent"
      }
    },
    "delete": {
      "data.family_id": "{{user.family_id}}",
      "user_condition": {
        "app_role": "parent"
      }
    }
  }
}