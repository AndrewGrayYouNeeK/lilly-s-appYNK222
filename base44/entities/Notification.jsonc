{
  "name": "Notification",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "approval",
        "redo",
        "submission",
        "purchase",
        "quest",
        "message",
        "badge"
      ],
      "default": "message"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "emoji": {
      "type": "string",
      "default": "\ud83d\udd14"
    },
    "link": {
      "type": "string",
      "description": "In-app path to navigate on click"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "recipient_email",
    "title"
  ],
  "rls": {
    "read": {
      "data.recipient_email": "{{user.email}}"
    },
    "create": {
      "data.family_id": "{{user.family_id}}"
    },
    "update": {
      "data.recipient_email": "{{user.email}}"
    },
    "delete": {
      "data.recipient_email": "{{user.email}}"
    }
  }
}