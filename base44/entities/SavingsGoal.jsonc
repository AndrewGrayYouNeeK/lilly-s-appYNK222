{
  "name": "SavingsGoal",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string"
    },
    "kid_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "emoji": {
      "type": "string",
      "default": "\ud83c\udfaf"
    },
    "target_amount": {
      "type": "number"
    },
    "saved_amount": {
      "type": "number",
      "default": 0
    },
    "allocation_pct": {
      "type": "number",
      "default": 0,
      "description": "% of each earning auto-saved to this goal (0-100)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "achieved",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "family_id",
    "kid_email",
    "title",
    "target_amount"
  ]
}