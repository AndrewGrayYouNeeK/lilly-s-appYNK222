{
  "name": "Family",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "invite_code": {
      "type": "string",
      "description": "6-char code kids use to join"
    },
    "currency_symbol": {
      "type": "string",
      "default": "$"
    },
    "currency_code": {
      "type": "string",
      "default": "USD"
    },
    "max_chores_per_day": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "name",
    "invite_code"
  ],
  "rls": {
    "read": {
      "id": "{{user.family_id}}"
    },
    "update": {
      "id": "{{user.family_id}}",
      "user_condition": {
        "app_role": "parent"
      }
    },
    "delete": {
      "id": "{{user.family_id}}",
      "user_condition": {
        "app_role": "parent"
      }
    }
  }
}